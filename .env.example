# Локальная разработка
DATABASE_URL=postgresql://academy:academy-local-only@127.0.0.1:5432/academy
APP_VERSION=development
APP_BASE_URL=http://localhost:3000

# Локально demo не создаёт реальных списаний.
PAYMENTS_MODE=demo
PAYMENT_DEFAULT_PROVIDER=demo
DEMO_WEBHOOK_SECRET=local-demo-only

# Локальная авторизация. В production demo-вход всегда отключён.
AUTH_DEMO_MODE=enabled
EMAIL_AUTH_MODE=demo
IDENTITY_SESSION_TTL_DAYS=30
TELEGRAM_BOT_USERNAME=AbrikosoffBot
TELEGRAM_BOT_TOKEN=

# Понадобятся при переключении PAYMENTS_MODE=live.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MERCHANT_ACCOUNT_ID=yookassa-primary
