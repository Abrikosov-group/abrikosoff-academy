[Unit]
Description=Зашифрованная внешняя копия PostgreSQL Академии
Documentation=https://github.com/Abrikosov-group/abrikosoff-academy
Wants=network-online.target
After=network-online.target
OnSuccess=academy-backup-monitor.service
ConditionPathExists=/opt/academy/backups/postgres/last-success
ConditionPathExists=/etc/academy-backup/age-recipient
ConditionPathExists=/etc/academy-backup/aws-access-key-id
ConditionPathExists=/etc/academy-backup/aws-secret-access-key

[Service]
Type=oneshot
User=deploy
Group=deploy
RuntimeDirectory=academy-postgres-offsite-backup
RuntimeDirectoryMode=0700
LoadCredential=aws-access-key-id:/etc/academy-backup/aws-access-key-id
LoadCredential=aws-secret-access-key:/etc/academy-backup/aws-secret-access-key
Environment=ACADEMY_OFFSITE_BUCKET=abrikosoff-academy-backups-prod-2026
Environment=ACADEMY_OFFSITE_ENDPOINT=https://storage.yandexcloud.net
Environment=ACADEMY_OFFSITE_REGION=ru-central1
Environment=ACADEMY_AGE_RECIPIENT_FILE=/etc/academy-backup/age-recipient
ExecStart=/usr/local/sbin/academy-postgres-offsite-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/academy/backups/postgres
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
