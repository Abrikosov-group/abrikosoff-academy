[Unit]
Description=Контроль резервных копий PostgreSQL Академии
Documentation=https://github.com/Abrikosov-group/abrikosoff-academy

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=ACADEMY_BACKUP_MAX_AGE_SECONDS=108000
Environment=ACADEMY_OFFSITE_BUCKET=abrikosoff-academy-backups-prod-2026
Environment=ACADEMY_OFFSITE_PREFIX=postgres
ExecStart=/usr/local/sbin/academy-backup-monitor
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2m

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
