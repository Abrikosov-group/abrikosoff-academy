[Unit]
Description=Проверенная резервная копия PostgreSQL Академии
Documentation=https://github.com/Abrikosov-group/abrikosoff-academy
Requires=docker.service
After=docker.service
OnSuccess=academy-postgres-offsite-backup.service
ConditionPathExists=/opt/academy/shared/.env

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
RuntimeDirectory=academy-postgres-backup
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/academy-postgres-backup/docker
ExecStartPre=/usr/bin/install -d -m 0700 /run/academy-postgres-backup/docker
ExecStart=/usr/local/sbin/academy-postgres-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/academy/backups/postgres
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
