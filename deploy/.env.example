ACADEMY_IMAGE=ghcr.io/abrikosov-group/abrikosoff-academy:development
APP_VERSION=development

POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://academy:replace-with-a-url-encoded-password@database:5432/academy

# Платежи в production включаются только после заполнения секретов.
APP_BASE_URL=https://academy.abrikosoff.com
PAYMENTS_MODE=disabled
PAYMENT_DEFAULT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MERCHANT_ACCOUNT_ID=yookassa-primary
AUTH_DEMO_MODE=disabled
EMAIL_AUTH_MODE=disabled
IDENTITY_SESSION_TTL_DAYS=30
TELEGRAM_BOT_USERNAME=AbrikosoffBot
TELEGRAM_BOT_TOKEN=
