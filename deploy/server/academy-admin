#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly academy_root="/opt/academy"
readonly shared_root="${academy_root}/shared"
readonly environment_file="${shared_root}/.env"
readonly current_link="${academy_root}/current"
readonly current_image_file="${shared_root}/current-image"
readonly project_name="academy-abrikosoff"
readonly image_repository="ghcr.io/abrikosov-group/abrikosoff-academy"
readonly operation_lock_timeout_seconds=600

fail() {
  printf 'Ошибка административной команды: %s\n' "$*" >&2
  exit 1
}

validate_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] \
    || fail "передан некорректный UUID"
}

[[ "${EUID}" -eq 0 ]] || fail "wrapper должен запускаться через sudo"
[[ "$#" -eq 10 ]] || fail "ожидалось ровно 10 аргументов"
[[ "$1" == "grant" ]] || fail "разрешена только команда grant"
[[ "$2" == "--user-id" ]] || fail "ожидался --user-id"
validate_uuid "$3"
[[ "$4" == "--role" && "$5" == "owner" ]] \
  || fail "разрешена только роль owner"
[[ "$6" == "--reason" ]] || fail "ожидался --reason"
[[ "${#7}" -ge 10 && "${#7}" -le 500 ]] \
  || fail "некорректная длина причины"
[[ "$7" =~ [^[:space:]] ]] \
  || fail "причина не может состоять из пробельных символов"
[[ "$7" != *$'\n'* && "$7" != *$'\r'* && "$7" != *$'\t'* ]] \
  || fail "причина содержит управляющий символ"
[[ "$8" == "--idempotency-key" ]] \
  || fail "ожидался --idempotency-key"
[[ "$9" =~ ^[A-Za-z0-9_-]{16,64}$ ]] \
  || fail "некорректный ключ идемпотентности"
[[ "${10}" == "--production" ]] \
  || fail "требуется флаг --production"

exec 9<"${academy_root}" \
  || fail "не удалось открыть каталог Академии для блокировки"
flock --exclusive --wait "${operation_lock_timeout_seconds}" 9 \
  || fail "не удалось дождаться завершения другой операции"

[[ -L "${current_link}" ]] || fail "текущий релиз не найден"
release_directory="$(readlink -f "${current_link}")"
readonly release_directory
app_version="${release_directory##*/}"
readonly app_version
readonly expected_release_directory="${academy_root}/releases/${app_version}"
[[ -f "${environment_file}" ]] || fail "файл окружения не найден"
[[ -f "${current_image_file}" ]] || fail "текущий образ не найден"
image_reference="$(<"${current_image_file}")"
readonly image_reference
image_digest="${image_reference#"${image_repository}"@}"
readonly image_digest

[[ "${app_version}" =~ ^[0-9a-f]{40}$ ]] \
  || fail "каталог текущего релиза не является SHA коммита"
[[ "${release_directory}" == "${expected_release_directory}" ]] \
  || fail "текущая ссылка указывает вне каталога релизов"
[[ \
  "${image_reference}" == "${image_repository}@${image_digest}" \
  && "${image_digest}" =~ ^sha256:[0-9a-f]{64}$ \
]] || fail "текущий образ не привязан к точному sha256 digest Академии"
[[ -f "${release_directory}/compose.production.yaml" ]] \
  || fail "Compose-конфигурация текущего релиза не найдена"

run_compose() {
  ACADEMY_IMAGE="${image_reference}" \
  ACADEMY_ENV_FILE="${environment_file}" \
  APP_VERSION="${app_version}" \
    docker compose \
      --project-name "${project_name}" \
      --env-file "${environment_file}" \
      --file "${release_directory}/compose.production.yaml" \
      "$@"
}

running_app_container="$(
  run_compose ps --quiet --status running app
)" || fail "не удалось определить запущенное production-приложение"
readonly running_app_container
[[ "${running_app_container}" =~ ^[0-9a-f]{12,64}$ ]] \
  || fail "production-приложение запущено не ровно в одном экземпляре"
active_image="$(
  docker inspect \
    --format '{{.Config.Image}}' \
    "${running_app_container}"
)" || fail "не удалось определить образ production-приложения"
readonly active_image
[[ "${active_image}" == "${image_reference}" ]] \
  || fail "запущенный production-образ не совпадает с текущим релизом"
active_revision="$(
  docker inspect \
    --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
    "${running_app_container}"
)" || fail "не удалось определить revision production-приложения"
readonly active_revision
[[ "${active_revision}" == "${app_version}" ]] \
  || fail "revision production-приложения не совпадает с SHA текущего релиза"

run_compose \
    run \
      --rm \
      --no-deps \
      -T \
      app \
      node scripts/academy-admin.mjs \
        grant \
        --user-id "$3" \
        --role owner \
        --reason "$7" \
        --idempotency-key "$9" \
        --production
